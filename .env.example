# Microsoft Graph delegated authentication through MSAL Python.
# Register a public client app, set Authentication > Allow public client flows to Yes,
# and grant delegated Files.Read.All + Sites.Read.All. Do not configure a client secret.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# LLM provider: azure_openai (recommended) or openai.
LLM_PROVIDER=azure_openai

# Azure OpenAI v1 Responses API. MODEL is your deployment name.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_OPENAI_MODEL=gpt-5.4-mini
# azure_cli for local development, managed_identity for Azure hosting, or api_key.
AZURE_OPENAI_AUTH_MODE=azure_cli
# AZURE_OPENAI_API_KEY=
# AZURE_CLIENT_ID=  # Optional user-assigned managed identity client ID.

# Direct OpenAI alternative.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Default SharePoint scope for chat/Inspector mode. Separate sites with semicolons.
# Use canonical site paths from SharePoint's Details pane, not sharing links.
SHAREPOINT_SITE_URLS=https://contoso.sharepoint.com/sites/Engineering/;https://contoso.sharepoint.com/sites/Policies/
# Set true only when every SharePoint site visible to the signed-in user is intended.
ALLOW_ALL_SITES=false

RETRIEVAL_MAX_RESULTS=25
MAX_CONTEXT_CHARACTERS=120000
INSPECTOR_PORT=8088
LOG_LEVEL=INFO
# Keep expected MSAL device-code polling responses out of normal output.
# Set to INFO temporarily only when troubleshooting authentication.
AUTH_SDK_LOG_LEVEL=WARNING
